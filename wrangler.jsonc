// Lets Cloudflare Workers serve this folder as a static site. The Worker in
// worker/ only answers /api/ (the Class app's files, lesson students' locked boxes, and what
// the studio publishes live; see worker/index.js).
{
  "name": "mrwashburnmusic-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Only serve on the real domain, so Cloudflare Access always guards /studio/.
  "workers_dev": false,
  "preview_urls": false,
  // Required by the branch builds Cloudflare runs on pull requests (npx wrangler preview).
  "previews": {},
  "routes": [
    { "pattern": "mrwashburnmusic.com", "custom_domain": true },
    { "pattern": "www.mrwashburnmusic.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/studio/api/*"]
  },
  // The Class app's decks, pictures and plans. Private: no public access, only through the Worker.
  "r2_buckets": [
    { "binding": "CLASS_FILES", "bucket_name": "mwm-class-files" }
  ],
  // Lesson students' locked boxes: one Durable Object each, holding only encrypted data.
  // LIVE: what Kyle publishes from the studio (grooves, game options, voice takes), one Durable Object.
  "durable_objects": {
    "bindings": [
      { "name": "BOXES", "class_name": "Box" },
      { "name": "LIVE", "class_name": "Live" },
      // VAULTS: Song Burner's cloud copy, one Durable Object per signed-in tester.
      { "name": "VAULTS", "class_name": "Vault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Box"] },
    { "tag": "v2", "new_sqlite_classes": ["Live"] },
    { "tag": "v3", "new_sqlite_classes": ["Vault"] }
  ],
  // Which Cloudflare Access login guards /api/class. Not secrets: the Worker checks each login
  // token's signature against Access's public keys, so knowing these lets no one in.
  "vars": {
    "ACCESS_TEAM": "mute-union-7a1d.cloudflareaccess.com",
    "ACCESS_AUD": "2bd16f1b6cec5e0b7a60223a7176858f37c303534f0a32c9f6fb287a47185aa9",
    // Song Burner's beta sign-in: the Audience tag of its own Access application, which
    // guards /songburner/account/ and /api/songburner/. Empty turns cloud sync off.
    "SONGBURNER_AUD": ""
  }
}
