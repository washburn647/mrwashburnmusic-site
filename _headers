# connect-src: Song Burner's lyrics search asks lrclib.net and lyrics.ovh directly.
# img-src blob: the class app shows pictures it keeps on the device (IndexedDB); media-src blob: its sound and video files.
# frame-src: the class app's video, Spotify and Street View widgets (YouTube's no-cookie player, Spotify's embed, Google Maps' embed).
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://lrclib.net https://api.lyrics.ovh; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)
  X-Frame-Options: DENY

/studio/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/songburner/sw.js
  Cache-Control: no-cache

/lesson/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/class/*
  X-Robots-Tag: noindex, nofollow

/class/sw.js
  Cache-Control: no-cache

/sub/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/musician-maker/*
  X-Robots-Tag: noindex, nofollow

/songburner/account/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Radio plays the stream links listeners add, so audio (media-src only) may come from any https host.
# Everything else on the page stays as strict as the rest of the site.
/radio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; media-src 'self' https:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: no-referrer

# Kyle's desktop dashboard reads the radio's station list (and /api/live/radio.json, see worker/index.js).
/radio/stations.json
  Access-Control-Allow-Origin: *
